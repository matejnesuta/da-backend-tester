# Trustify DA Backend Tester Configuration
# Copy this file to .env and update with your paths

# GitHub Token (REQUIRED for building Java client from source in container)
# Get token from: https://github.com/settings/tokens
# Required scope: read:packages
# GITHUB_TOKEN=ghp_your_token_here

# OPTIONAL: Override built-in clients with custom versions
# The container includes pre-built clients from source.
# Only set these if you want to test locally-built clients.

# Java Client (JAR file path)
# TRUSTIFY_DA_JAVA_CLIENT=/path/to/custom-trustify-da-java-client.jar

# JavaScript Client (executable path)
# TRUSTIFY_DA_JS_CLIENT=/path/to/custom-trustify-da-js-client

# Backend URL (for future backend testing)
# TRUSTIFY_DA_BACKEND_URL=https://your-backend-instance.example.com
