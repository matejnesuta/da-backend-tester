# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# Environment files
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Test outputs
test-results/
*.log

# Test failure cache (optional - can be committed to share failures with team)
.test-failures.json

# Pytest
.pytest_cache/

# Syrupy snapshots - UNCOMMENT to ignore snapshots (usually you want to commit them)
# __snapshots__/

# Build artifacts and dependencies generated during test runs
testfiles/**/.gradle/
testfiles/**/build/
testfiles/**/target/
testfiles/**/node_modules/
testfiles/**/dist/
testfiles/**/__pycache__/
testfiles/**/.pytest_cache/
testfiles/**/venv/

# pnpm content-addressable store
testfiles/**/.pnpm-store/
testfiles/.pnpm-store/

# IMPORTANT: Lock files ARE committed in testfiles/ (needed for reproducible tests)
# Only ignore node_modules and build caches in tests/ subdirectory
tests/**/testfiles/**/node_modules/
tests/**/testfiles/**/.gradle/
tests/**/testfiles/**/build/
tests/**/testfiles/**/target/
tests/**/testfiles/**/dist/
tests/**/testfiles/**/__pycache__/
tests/**/testfiles/**/.pytest_cache/
tests/**/testfiles/**/venv/
tests/**/testfiles/**/.pnpm-store/

# Old test failure cache
testfiles/.test-failures.json
